package httpui

import (
	"slices"
	"strconv"

	"github.com/gotthboard/gotth-bb/internal/auth"
)

templ document(view pageView, content templ.Component) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-950">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfiguration }/>
			<title>{ view.Title } · { view.SiteName }</title>
			if view.CanonicalURL != "" {
				<link rel="canonical" href={ view.CanonicalURL }/>
			}
			<link rel="stylesheet" href={ view.StylesheetURL }/>
		</head>
		<body class="min-h-full bg-slate-950 text-slate-200 antialiased">
			<a href="#main-content" class="sr-only fixed left-4 top-4 z-50 rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 focus:not-sr-only focus:outline-2 focus:outline-offset-2 focus:outline-cyan-100">Skip to main content</a>
			<header class="border-b border-slate-800 bg-gradient-to-b from-blue-950 to-slate-950 text-white shadow-lg shadow-black/20">
				<div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
						<div>
							<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="w-fit rounded-sm text-2xl font-bold tracking-tight text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">{ view.SiteName }</a>
							<p class="mt-1 text-sm text-blue-100">Community discussions, plainly organized.</p>
						</div>
						<nav aria-label="Primary" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
						<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Board index</a>
						<a href={ view.SearchURL } hx-get={ view.SearchURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Search</a>
						<a href={ view.ActivityURL } hx-get={ view.ActivityURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Recent activity</a>
						if sessionAuthenticationFromContext(ctx).Access.Role == auth.RoleAdministrator {
							<a href={ view.AdminURL } hx-get={ view.AdminURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Manage areas</a>
						}
						if reportFormsEnabled(ctx) && (sessionAuthenticationFromContext(ctx).Access.Role == auth.RoleModerator || sessionAuthenticationFromContext(ctx).Access.Role == auth.RoleAdministrator) {
							<a href={ view.ReportsURL } hx-get={ view.ReportsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Reports</a>
						}
						if sessionAuthenticationFromContext(ctx).Access.Authenticated {
							<form method="post" action={ view.LogoutURL }>
								<input type="hidden" name="_csrf" value={ csrfTokenFromContext(ctx) }/>
								<button type="submit" class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Log out</button>
							</form>
						} else {
							<a href={ view.LoginURL } class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Log in</a>
							if registrationEnabledFromContext(ctx) {
								<a href={ view.RegisterURL } class="rounded-sm font-semibold text-white hover:text-blue-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Register</a>
							}
						}
						</nav>
					</div>
				</div>
			</header>
			@content
			@footer(view, footerLoadTimesFromContext(ctx))
			<script src={ view.HTMXURL } defer></script>
			<script src={ view.DiscoveryResponseURL } defer></script>
			<script src={ view.MarkdownToolbarURL } defer></script>
		</body>
	</html>
}

templ areaAdministrationPage(view pageView, page areaAdministrationPageView) {
	@document(view, areaAdministrationContent(view, page))
}

templ areaAdministrationContent(view pageView, page areaAdministrationPageView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-500">/</span>
			<span aria-current="page" class="text-slate-400">Manage areas</span>
		</nav>
		<section aria-labelledby="area-administration-title" class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-cyan-300">Administration</p>
			<h1 id="area-administration-title" class="text-3xl font-bold tracking-tight text-white">Manage discussion areas</h1>
			<p class="mt-4 text-slate-300">Create the places where topics and replies live. Area slugs cannot be changed after creation.</p>
			if page.FormError != "" {
				<p role="alert" class="mt-6 rounded-md border border-rose-900/70 bg-rose-950/40 p-3 text-rose-200">{ page.FormError }</p>
			}
			<div class="mt-8 rounded-lg border border-cyan-900/70 bg-slate-950/60 p-5">
				<h2 class="text-xl font-semibold text-white">Create area</h2>
				@areaAdministrationForm(page.ActionURL, page.CSRFToken, areaAdministrationFormView{DisplayOrder: "0", Visibility: "public", PostingMode: "normal"}, page.Groups)
			</div>
		</section>
		<section aria-labelledby="existing-areas-title" class="mt-8">
			<h2 id="existing-areas-title" class="text-2xl font-bold text-white">Existing areas</h2>
			if len(page.Areas) == 0 {
				<p class="mt-4 rounded-lg border border-dashed border-slate-700 bg-slate-950/60 p-6 text-slate-300">No areas exist yet.</p>
			} else {
				<div class="mt-4 grid gap-6">
					for _, area := range page.Areas {
						<section class="rounded-xl border border-slate-800 bg-slate-900 p-6">
							<h3 class="text-xl font-semibold text-white">{ area.Name }</h3>
							<p class="mt-1 text-sm text-slate-400">/{ area.Slug }</p>
							@areaAdministrationForm(area.ActionURL, page.CSRFToken, area, page.Groups)
						</section>
					}
				</div>
			}
		</section>
	</main>
}

templ areaAdministrationForm(actionURL string, csrfToken string, area areaAdministrationFormView, groups []areaAdministrationGroupView) {
	<form method="post" action={ actionURL } hx-post={ actionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-6 grid gap-5">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		if area.Editing {
			<input type="hidden" name="revision" value={ area.Revision }/>
		}
		<label class="grid gap-2 font-semibold text-slate-200">
			Slug
			<input name="slug" value={ area.Slug } required maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" readonly?={ area.Editing } class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white read-only:text-slate-400"/>
		</label>
		<label class="grid gap-2 font-semibold text-slate-200">
			Name
			<input name="name" value={ area.Name } required maxlength="120" class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white"/>
		</label>
		<label class="grid gap-2 font-semibold text-slate-200">
			Description
			<textarea name="description" maxlength="4000" rows="3" class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white">{ area.Description }</textarea>
		</label>
		<div class="grid gap-5 sm:grid-cols-3">
			<label class="grid gap-2 font-semibold text-slate-200">
				Display order
				<input name="display_order" value={ area.DisplayOrder } type="number" min="0" max="2147483647" required class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white"/>
			</label>
			<label class="grid gap-2 font-semibold text-slate-200">
				Visibility
				<select name="visibility" class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white">
					<option value="public" selected?={ area.Visibility == "" || area.Visibility == "public" }>Public</option>
					<option value="authenticated" selected?={ area.Visibility == "authenticated" }>Signed-in members</option>
					if len(groups) > 0 {
						<option value="groups" selected?={ area.Visibility == "groups" }>Selected groups</option>
					}
				</select>
			</label>
			<label class="grid gap-2 font-semibold text-slate-200">
				Posting mode
				<select name="posting_mode" class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white">
					<option value="normal" selected?={ area.PostingMode == "" || area.PostingMode == "normal" }>Normal</option>
					<option value="read_only" selected?={ area.PostingMode == "read_only" }>Read only</option>
					<option value="archived" selected?={ area.PostingMode == "archived" }>Archived</option>
				</select>
			</label>
		</div>
		if len(groups) > 0 {
			<fieldset class="grid gap-2 rounded-md border border-slate-700 p-4">
				<legend class="px-2 font-semibold text-slate-200">Groups (only for Selected groups visibility)</legend>
				for _, group := range groups {
					<label class="flex items-center gap-2 text-slate-300">
						<input type="checkbox" name="group_id" value={ strconv.FormatInt(group.ID, 10) } checked?={ slices.Contains(area.GroupIDs, group.ID) }/>
						{ group.Name }
					</label>
				}
			</fieldset>
		}
		<label class="grid gap-2 font-semibold text-slate-200">
			Audit reason
			<input name="reason" value={ area.Reason } required maxlength="2000" autocomplete="off" class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white"/>
		</label>
		<button type="submit" class="w-fit rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200">
			if area.Editing {
				Save area
			} else {
				Create area
			}
		</button>
	</form>
}

templ administratorSetupPage(view pageView, setup administratorSetupView) {
	@document(view, administratorSetupContent(view, setup))
}

templ administratorSetupContent(view pageView, setup administratorSetupView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-3xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<section aria-labelledby="setup-title" class="rounded-xl border border-amber-700/60 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-amber-300">One-time deployment setup</p>
			<h1 id="setup-title" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Claim first administration</h1>
			<p class="mt-4 leading-7 text-slate-300">This permanently grants your current board account the administrator role and records an immutable audit event.</p>
			<p class="mt-3 leading-7 text-slate-300">Your current session will end. You must log in again before using administrator controls.</p>
			<form method="post" action={ setup.ActionURL } class="mt-8">
				<input type="hidden" name="_csrf" value={ setup.CSRFToken }/>
				<button type="submit" class="rounded-md bg-amber-300 px-4 py-2 font-semibold text-slate-950 hover:bg-amber-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-amber-300">Claim administrator role</button>
			</form>
		</section>
	</main>
}

templ footer(view pageView, loadTimes footerLoadTimesView) {
	<footer class="border-t border-slate-800" aria-label="Software information">
		<div class="mx-auto flex max-w-6xl flex-wrap gap-x-3 gap-y-1 px-4 py-6 text-sm text-slate-400 sm:px-6 lg:px-8">
			<span>Powered by <a href={ view.HomeURL } class="rounded-sm font-medium text-cyan-300 hover:text-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{ view.SiteName }</a></span>
			if loadTimes.Version != "" {
				<span>Version: <strong class="font-medium text-slate-200">{ loadTimes.Version }</strong></span>
				<span>Page: <strong class="font-medium text-slate-200">{ loadTimes.PageTime }</strong></span>
				<span>Template: <strong class="font-medium text-slate-200">{ loadTimes.TemplateTime }</strong></span>
			}
		</div>
	</footer>
}

templ areaIndexPageWithAreas(view pageView, areas []areaIndexItem, notice areaIndexNotice) {
	@document(view, areaIndexContentWithAreas(view, areas, notice))
}

templ areaIndexContentWithAreas(view pageView, areas []areaIndexItem, notice areaIndexNotice) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-6 focus:outline-none sm:px-6 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-3 rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-300 shadow-sm">
			<ol>
				<li><span aria-current="page">Areas</span></li>
			</ol>
		</nav>
		if notice == areaIndexLogoutVerificationFailed {
			<div role="alert" class="mb-6 rounded-lg border border-amber-800/70 bg-amber-950/20 p-4 text-amber-100">
				Logout failed because the page was stale. You are still logged in. Please try again.
			</div>
		}
		if notice == areaIndexReportSubmitted {
			<div role="status" class="mb-6 rounded-lg border border-emerald-800/70 bg-emerald-950/20 p-4 text-emerald-100">
				Your report was submitted to the moderation queue.
			</div>
		}
		<section aria-labelledby="areas-title" class="overflow-hidden rounded border border-slate-700 bg-slate-900 shadow-lg shadow-black/20">
			<div class="border-b border-slate-700 bg-gradient-to-b from-blue-900 to-blue-950 px-4 py-2 text-white">
				<h1 id="areas-title" class="text-base font-bold">Discussion areas</h1>
			</div>
			if len(areas) == 0 {
				<p class="px-4 pt-4 text-slate-300">No public discussion areas are available yet.</p>
				<div role="status" aria-live="polite" class="m-4 rounded border border-dashed border-slate-700 bg-slate-950/60 p-5 text-slate-300">
					This community is ready for its first discussion area.
				</div>
			} else {
				<div class="hidden grid-cols-[minmax(0,1fr)_5rem_5rem_minmax(13rem,0.7fr)] gap-3 border-b border-slate-700 bg-slate-800 px-4 py-2 text-xs font-bold uppercase tracking-wide text-slate-300 md:grid" aria-hidden="true">
					<span>Forum</span><span class="text-center">Topics</span><span class="text-center">Posts</span><span>Last post</span>
				</div>
				<ul class="divide-y divide-slate-700">
					for _, area := range areas {
						<li class="grid gap-3 bg-slate-900 px-4 py-4 even:bg-slate-950 md:grid-cols-[minmax(0,1fr)_5rem_5rem_minmax(13rem,0.7fr)] md:items-center">
							<div class="flex min-w-0 gap-3">
								<span aria-hidden="true" class="mt-1 flex size-9 shrink-0 items-center justify-center rounded-full border border-blue-700 bg-blue-950 text-lg text-blue-300">●</span>
								<div class="min-w-0">
									<h2 class="font-bold">
										<a href={ area.URL } hx-get={ area.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-blue-300 hover:text-blue-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">{ area.Name }</a>
									</h2>
									if area.Description != "" {
										<p class="mt-1 text-sm leading-5 text-slate-400">{ area.Description }</p>
									}
								</div>
							</div>
							<div class="flex gap-4 text-sm text-slate-300 md:contents">
								<p class="md:text-center"><span class="font-semibold md:sr-only">Topics: </span>{ area.TopicCount }</p>
								<p class="md:text-center"><span class="font-semibold md:sr-only">Posts: </span>{ area.PostCount }</p>
							</div>
							<div class="min-w-0 text-sm text-slate-400">
								if area.LatestURL != "" {
									<a href={ area.LatestURL } hx-get={ area.LatestURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="block truncate font-semibold text-blue-300 hover:text-blue-100 hover:underline">{ area.LatestTitle }</a>
									<p class="mt-1">by { area.LatestAuthor }</p>
									<p>{ area.LatestAt }</p>
								} else {
									<span>No posts</span>
								}
							</div>
						</li>
					}
				</ul>
			}
		</section>
	</main>
}

templ areaTopicListPage(view pageView, area areaTopicListView) {
	@document(view, areaTopicListContent(view, area))
}

templ areaTopicListContent(view pageView, area areaTopicListView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-6 focus:outline-none sm:px-6 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-3 rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-300 shadow-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-blue-300 hover:text-blue-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">Board index</a>
			<span aria-hidden="true" class="px-2 text-slate-400">›</span>
			<span aria-current="page">{ area.Name }</span>
		</nav>
		<div class="mb-3 flex flex-wrap items-end justify-between gap-3">
			<div>
				<h1 id="area-title" class="text-2xl font-bold tracking-tight text-slate-100">{ area.Name }</h1>
				if area.Description != "" {
					<p class="mt-1 max-w-3xl text-sm leading-6 text-slate-400">{ area.Description }</p>
				}
			</div>
			if area.NewTopicURL != "" {
				<a href={ area.NewTopicURL } hx-get={ area.NewTopicURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="inline-flex rounded border border-blue-950 bg-gradient-to-b from-blue-600 to-blue-800 px-4 py-2 text-sm font-bold text-white shadow-sm hover:from-blue-500 hover:to-blue-700">New topic</a>
			}
		</div>
		<section aria-labelledby="area-title" class="overflow-hidden rounded border border-slate-700 bg-slate-900 shadow-lg shadow-black/20">
			<div class="hidden grid-cols-[minmax(0,1fr)_7rem_minmax(12rem,0.55fr)] gap-3 border-b border-slate-700 bg-gradient-to-b from-blue-900 to-blue-950 px-4 py-2 text-xs font-bold uppercase tracking-wide text-white md:grid" aria-hidden="true">
				<span>Topics</span><span class="text-center">Replies</span><span>Last activity</span>
			</div>
			if len(area.Topics) == 0 {
				<div role="status" aria-live="polite" class="m-4 rounded border border-dashed border-slate-700 bg-slate-950/60 p-5 text-slate-300">
					No topics have been published in this area yet.
				</div>
			} else {
				<p class="border-b border-slate-700 bg-slate-800 px-4 py-2 text-xs text-slate-300">Page { area.Number } · { area.TotalTopics } topics available to you</p>
				<ul class="divide-y divide-slate-700">
					for _, topic := range area.Topics {
						<li class="grid gap-3 bg-slate-900 px-4 py-4 even:bg-slate-950 md:grid-cols-[minmax(0,1fr)_7rem_minmax(12rem,0.55fr)] md:items-center">
							<div class="flex min-w-0 gap-3">
								<span aria-hidden="true" class="mt-1 flex size-9 shrink-0 items-center justify-center rounded-full border border-blue-700 bg-blue-950 text-blue-300">●</span>
								<div class="min-w-0">
									<div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wide text-slate-400">
										if topic.Pinned {
											<span class="rounded border border-amber-700 bg-amber-950/40 px-1.5 py-0.5 text-amber-200">Pinned</span>
										}
										<span>{ topic.StateLabel }</span>
									</div>
									<h2 class="mt-1 font-bold">
										<a href={ topic.URL } hx-get={ topic.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-blue-300 hover:text-blue-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">{ topic.Title }</a>
									</h2>
									<p class="mt-1 text-xs text-slate-400">Started by { topic.Author }</p>
								</div>
							</div>
							<p class="text-sm text-slate-300 md:text-center"><span class="font-semibold md:sr-only">Replies: </span>{ topic.ReplyLabel }</p>
							<p class="text-sm text-slate-400"><span class="font-semibold md:sr-only">Last activity: </span>{ topic.LastActivity }</p>
						</li>
					}
				</ul>
			}
		</section>
		if area.PreviousURL != "" || area.NextURL != "" {
			<nav aria-label="Topic pages" class="mt-4 flex flex-wrap items-center gap-2">
				if area.PreviousURL != "" {
					<a href={ area.PreviousURL } hx-get={ area.PreviousURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-semibold text-blue-300 shadow-sm hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">Previous</a>
				}
				if area.NextURL != "" {
					<a href={ area.NextURL } hx-get={ area.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm font-semibold text-blue-300 shadow-sm hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">Next</a>
				}
			</nav>
		}
	</main>
}

templ topicPostListPage(view pageView, topic topicPostPageView) {
	@document(view, topicPostListContent(view, topic))
}

templ topicPostListContent(view pageView, topic topicPostPageView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-4 rounded border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-300 shadow-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-blue-300 hover:text-blue-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">Board index</a>
			<span aria-hidden="true" class="px-2 text-slate-400">›</span>
			<a href={ topic.AreaURL } hx-get={ topic.AreaURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-semibold text-blue-300 hover:text-blue-100 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-300">{ topic.AreaName }</a>
			<span aria-hidden="true" class="px-2 text-slate-400">›</span>
			<span aria-current="page">{ topic.Title }</span>
		</nav>
		<section aria-labelledby="topic-title" class="rounded border border-slate-700 bg-slate-900 p-4 text-slate-200 shadow-lg shadow-black/20 sm:p-5">
			<div class="flex flex-wrap items-center gap-3 text-sm">
				if topic.Pinned {
					<span class="rounded border border-amber-700 bg-amber-950/40 px-2 py-1 font-semibold text-amber-200">Pinned</span>
				}
				<span class="font-semibold text-slate-300">{ topic.StateLabel }</span>
			</div>
			<h1 id="topic-title" class="mt-2 text-2xl font-bold tracking-tight text-blue-100 sm:text-3xl">{ topic.Title }</h1>
			<p class="mt-2 text-sm text-slate-400">Started by { topic.Author } · { topic.Started }</p>
			<p class="mt-1 text-sm text-slate-400">Page { topic.Number } · { topic.TotalPosts } visible conversation nodes</p>
			if topic.Report.ActionURL != "" {
				@reportForm(topic.Report)
			}
			for _, control := range topic.Moderation {
				<form method="post" action={ control.ActionURL } hx-post={ control.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-6 grid max-w-xl gap-3 rounded-lg border border-amber-800/70 bg-amber-950/20 p-4">
					<input type="hidden" name="_csrf" value={ control.CSRFToken }/>
					<label class="grid gap-2 font-semibold text-amber-100">
						Moderation reason
						<input type="text" name="reason" required maxlength="2000" autocomplete="off" class="rounded-md border border-amber-800 bg-slate-950 px-3 py-2 text-white"/>
					</label>
					<button type="submit" class="w-fit rounded-md border border-amber-700 px-4 py-2 font-semibold text-amber-100 hover:border-amber-500">{ control.SubmitLabel }</button>
				</form>
			}
			for _, control := range topic.Extended {
				@extendedModerationForm(control)
			}
		</section>
		if len(topic.Posts) == 0 {
			<div role="status" aria-live="polite" class="mt-6 rounded-lg border border-dashed border-slate-700 bg-slate-950/60 p-6 text-slate-300">
				No visible posts are available in this topic yet.
			</div>
		} else {
			<ol class="mt-4 grid gap-3">
				for _, post := range topic.Posts {
					<li class={ "min-w-0 " + post.IndentClass }>
						<article id={ post.Anchor } aria-labelledby={ post.Anchor + "-author" } class="scroll-mt-6 overflow-hidden rounded border border-slate-700 border-l-4 border-l-blue-500 bg-slate-900 text-slate-200 shadow-lg shadow-black/20">
							if post.ParentURL != "" {
								<p class="border-b border-slate-700 bg-slate-950/60 px-3 py-2 text-xs text-slate-400">
									<a href={ post.ParentURL } hx-get={ post.ParentURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="font-semibold text-blue-300 hover:text-blue-100 hover:underline">{ post.ParentLabel }</a>
								</p>
							}
							if post.Tombstone {
								<div class="px-4 py-5 text-sm italic text-slate-400">
									<h2 id={ post.Anchor + "-author" } class="sr-only">Deleted post</h2>
									if post.Redacted {
										This post was permanently redacted by moderation. Replies remain in their original conversation branch.
									} else {
										This post was deleted. Replies remain in their original conversation branch.
									}
									for _, control := range post.Moderation {
										@extendedModerationForm(control)
									}
								</div>
							} else {
								<div class="md:grid md:grid-cols-[11rem_minmax(0,1fr)]">
									<header class="border-b border-slate-700 bg-slate-800 px-4 py-3 md:border-r md:border-b-0">
									<h2 id={ post.Anchor + "-author" } class="font-bold text-blue-100">{ post.Author }</h2>
									<p class="mt-1 text-xs text-slate-400">Posted { post.Created }</p>
									if post.Edited != "" {
										<p class="mt-1 text-xs text-slate-400">{ post.Edited }</p>
									}
									if post.AuthorStatusURL != "" {
										<a href={ post.AuthorStatusURL } hx-get={ post.AuthorStatusURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="mt-2 inline-block text-xs font-semibold text-blue-300 hover:text-blue-100 hover:underline">Account status</a>
									}
									if post.ReportAuthor.ActionURL != "" {
										@reportForm(post.ReportAuthor)
									}
									</header>
									<div class="min-w-0 p-4">
										<div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-700 pb-2 text-xs">
											<div class="flex flex-wrap gap-3">
										if post.AuthorStatusURL != "" {
											<span class="sr-only">Moderation available</span>
										}
										if post.EditURL != "" {
											<a href={ post.EditURL } hx-get={ post.EditURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="font-semibold text-blue-300 hover:text-blue-100 hover:underline">Edit</a>
										}
										if post.DeleteURL != "" {
											<form method="post" action={ post.DeleteURL } hx-post={ post.DeleteURL } hx-target="#main-content" hx-swap="outerHTML" class="inline">
												<input type="hidden" name="_csrf" value={ post.CSRFToken }/>
												<input type="hidden" name="revision" value={ post.Revision }/>
												<button type="submit" class="font-semibold text-rose-300 hover:text-rose-200 hover:underline">Delete</button>
											</form>
										}
											</div>
											<a href={ post.Permalink } class="font-semibold text-blue-300 hover:text-blue-100 hover:underline">Post #{ post.Number }</a>
										</div>
									<div class="rendered-post mt-4 min-w-0 max-w-full space-y-4 break-words leading-7 text-slate-200">@post.Body.Component()</div>
									if post.Report.ActionURL != "" {
											@reportForm(post.Report)
									}
									for _, control := range post.Moderation {
										@extendedModerationForm(control)
									}
										if post.ShowReply {
											<details class="mt-5 border-t border-slate-700 pt-3">
												<summary class="w-fit cursor-pointer rounded bg-blue-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-blue-800">Reply</summary>
												@inlineReplyForm(post.ReplyForm)
											</details>
										}
									</div>
								</div>
							}
						</article>
					</li>
				}
			</ol>
		}
		if topic.PreviousURL != "" || topic.NextURL != "" {
			<nav aria-label="Post pages" class="mt-8 flex flex-wrap items-center gap-4">
				if topic.PreviousURL != "" {
					<a href={ topic.PreviousURL } hx-get={ topic.PreviousURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Previous</a>
				}
				if topic.NextURL != "" {
					<a href={ topic.NextURL } hx-get={ topic.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Next</a>
				}
			</nav>
		}
		if topic.ShowReply {
			@publishingFormSection(topic.ReplyForm)
		}
	</main>
}

templ reportForm(form reportFormView) {
	<details class="mt-3 text-sm">
		<summary class="w-fit cursor-pointer font-semibold text-rose-300 hover:text-rose-200">{ form.SubmitLabel }</summary>
		<form method="post" action={ form.ActionURL } hx-post={ form.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-3 grid gap-2 rounded border border-rose-900/70 bg-rose-950/20 p-3">
			<input type="hidden" name="_csrf" value={ form.CSRFToken }/>
			<input type="hidden" name="target_type" value={ form.TargetType }/>
			<input type="hidden" name="target_id" value={ form.TargetID }/>
			<label class="grid gap-1 font-semibold text-rose-100">Reason<textarea name="reason" required maxlength="2000" rows="3" class="rounded border border-rose-900 bg-slate-950 px-3 py-2 text-white"></textarea></label>
			<button type="submit" class="w-fit rounded border border-rose-700 px-3 py-1.5 font-semibold text-rose-100">Submit report</button>
		</form>
	</details>
}

templ extendedModerationForm(form extendedModerationView) {
	<form method="post" action={ form.ActionURL } hx-post={ form.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-3 grid max-w-xl gap-2 rounded border border-amber-900/70 bg-amber-950/20 p-3 text-sm">
		<input type="hidden" name="_csrf" value={ form.CSRFToken }/>
		<input type="hidden" name="action" value={ form.Action }/>
		<input type="hidden" name="target_id" value={ form.TargetID }/>
		if form.ExtraField != "" {
			<label class="grid gap-1 font-semibold text-amber-100">{ form.ExtraLabel }<input name={ form.ExtraField } required maxlength="80" class="rounded border border-amber-900 bg-slate-950 px-3 py-2 text-white"/></label>
		}
		<label class="grid gap-1 font-semibold text-amber-100">Moderation reason<input name="reason" required maxlength="2000" class="rounded border border-amber-900 bg-slate-950 px-3 py-2 text-white"/></label>
		<button type="submit" class="w-fit rounded border border-amber-700 px-3 py-1.5 font-semibold text-amber-100">{ form.SubmitLabel }</button>
	</form>
}

templ moderationReportListPage(view pageView, page moderationReportListView) {
	@document(view, moderationReportListContent(view, page))
}

templ moderationReportListContent(view pageView, page moderationReportListView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-5xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12">
		<h1 class="text-3xl font-bold text-white">Moderation reports</h1>
		<p class="mt-2 text-slate-400">{ page.Total } active reports · page { page.Number }</p>
		if len(page.Reports) == 0 {
			<p class="mt-6 rounded border border-slate-700 bg-slate-900 p-5 text-slate-300">The active report queue is empty.</p>
		} else {
			<ol class="mt-6 grid gap-4">
				for _, report := range page.Reports {
					<li class="rounded border border-slate-700 bg-slate-900 p-5">
						<div class="flex flex-wrap justify-between gap-3"><a href={ report.DetailURL } hx-get={ report.DetailURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="font-bold text-blue-300">{ report.TargetType }: { report.TargetLabel }</a><span class="font-semibold text-amber-200">{ report.Status }</span></div>
						<p class="mt-2 whitespace-pre-wrap text-slate-200">{ report.Reason }</p>
						<p class="mt-3 text-sm text-slate-400">Reported by { report.Reporter } · { report.Created }</p>
						if report.Assignee != "" {
							<p class="mt-1 text-sm text-slate-400">Assigned to { report.Assignee }</p>
						}
					</li>
				}
			</ol>
		}
		<nav aria-label="Report pages" class="mt-8 flex gap-4">
			if page.PreviousURL != "" {
				<a href={ page.PreviousURL } hx-get={ page.PreviousURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Previous</a>
			}
			if page.NextURL != "" {
				<a href={ page.NextURL } hx-get={ page.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Next</a>
			}
		</nav>
	</main>
}

templ moderationReportDetailPage(view pageView, report moderationReportDetailView) {
	@document(view, moderationReportDetailContent(view, report))
}

templ moderationReportDetailContent(view pageView, report moderationReportDetailView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-4xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12">
		<a href={ view.ReportsURL } hx-get={ view.ReportsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="font-semibold text-blue-300">← Report queue</a>
		<section class="mt-5 rounded border border-slate-700 bg-slate-900 p-6">
			<h1 class="text-3xl font-bold text-white">Report #{ report.ID }</h1>
			<p class="mt-3"><a href={ report.TargetURL } class="font-semibold text-blue-300">{ report.TargetType }: { report.TargetLabel }</a></p>
			<p class="mt-4 whitespace-pre-wrap text-slate-200">{ report.Reason }</p>
			<p class="mt-3 text-sm text-slate-400">Reporter: { report.Reporter } · Status: { report.Status } · Created: { report.Created }</p>
			if report.Assignee != "" {
				<p class="mt-1 text-sm text-slate-400">Assigned to { report.Assignee }</p>
			}
			if report.Resolution != "" {
				<p class="mt-4 rounded border border-slate-700 bg-slate-950 p-4 whitespace-pre-wrap">Resolution: { report.Resolution } · { report.Resolver }</p>
			}
			if report.ClaimAction != "" {
				<form method="post" action={ report.ClaimAction } class="mt-6"><input type="hidden" name="_csrf" value={ report.CSRFToken }/><button class="rounded bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Claim report</button></form>
			}
			if report.NoteAction != "" {
				@reportActionForm(report.NoteAction, report.CSRFToken, "note", "Add moderator note")
				@reportActionForm(report.ResolveAction, report.CSRFToken, "resolution", "Resolve report")
				@reportActionForm(report.DismissAction, report.CSRFToken, "resolution", "Dismiss report")
			}
		</section>
		<section class="mt-6"><h2 class="text-2xl font-bold text-white">Moderator notes</h2>
			if len(report.Notes) == 0 {
				<p class="mt-3 text-slate-400">No notes.</p>
			} else {
				<ol class="mt-3 grid gap-3">
					for _, note := range report.Notes {
						<li class="rounded border border-slate-700 bg-slate-900 p-4"><p class="whitespace-pre-wrap">{ note.Body }</p><p class="mt-2 text-sm text-slate-400">{ note.Author } · { note.Created }</p></li>
					}
				</ol>
			}
		</section>
	</main>
}

templ reportActionForm(actionURL string, csrfToken string, field string, label string) {
	<form method="post" action={ actionURL } hx-post={ actionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-5 grid gap-2 rounded border border-amber-900/70 bg-amber-950/20 p-4">
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<label class="grid gap-1 font-semibold">{ label }<textarea name={ field } required maxlength="2000" rows="3" class="rounded border border-amber-900 bg-slate-950 px-3 py-2 text-white"></textarea></label>
		<button type="submit" class="w-fit rounded border border-amber-700 px-4 py-2 font-semibold text-amber-100">{ label }</button>
	</form>
}

templ markdownToolbarButtons() {
	<button type="button" data-markdown-action="bold" aria-label="Bold" title="Bold" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Bold</button>
	<button type="button" data-markdown-action="italic" aria-label="Italic" title="Italic" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Italic</button>
	<button type="button" data-markdown-action="link" aria-label="Link" title="Link" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Link</button>
	<button type="button" data-markdown-action="quote" aria-label="Block quote" title="Block quote" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Quote</button>
	<button type="button" data-markdown-action="inline-code" aria-label="Inline code" title="Inline code" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Code</button>
	<button type="button" data-markdown-action="fenced-code" aria-label="Fenced code block" title="Fenced code block" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Code block</button>
	<button type="button" data-markdown-action="ordered-list" aria-label="Ordered list" title="Ordered list" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Numbered list</button>
	<button type="button" data-markdown-action="unordered-list" aria-label="Unordered list" title="Unordered list" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Bullet list</button>
	<button type="button" data-markdown-action="table" aria-label="Table" title="Table" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Table</button>
	<button type="button" data-markdown-action="task-list" aria-label="Task list" title="Task list" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Task list</button>
	<button type="button" data-markdown-action="strike" aria-label="Strikethrough" title="Strikethrough" class="rounded-md border border-slate-700 px-3 py-2 text-sm font-semibold text-slate-200 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Strike</button>
}

templ inlineReplyForm(form publishingFormView) {
	<form method="post" action={ form.ActionURL } hx-post={ form.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-3 grid gap-3">
		<input type="hidden" name="_csrf" value={ form.CSRFToken }/>
		<input type="hidden" name="parent_post_id" value={ form.ParentPostID }/>
		<div data-markdown-editor class="grid gap-2">
			<label for={ "markdown-reply-" + form.ParentPostID } class="text-sm font-semibold text-slate-200">{ form.Heading }</label>
			<div data-markdown-toolbar hidden role="group" aria-label="Markdown formatting" class="flex flex-wrap gap-2">@markdownToolbarButtons()</div>
			<textarea id={ "markdown-reply-" + form.ParentPostID } name="markdown" required maxlength="65536" rows="6" class="rounded border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-white"></textarea>
		</div>
		<div class="flex flex-wrap gap-2">
			<button type="submit" class="rounded bg-blue-700 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-800">Post reply</button>
			<button type="submit" formaction={ form.PreviewURL } hx-post={ form.PreviewURL } class="rounded border border-slate-700 bg-slate-950 px-4 py-2 text-sm font-semibold text-slate-200 hover:bg-slate-800">Preview</button>
		</div>
	</form>
}

templ publishingFormPage(view pageView, form publishingFormView) {
	@document(view, publishingFormContent(view, form))
}

templ moderationUserPage(view pageView, user moderationUserView) {
	@document(view, moderationUserContent(view, user))
}

templ moderationUserContent(view pageView, user moderationUserView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-3xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-500">/</span>
			<span aria-current="page" class="text-slate-400">Account status</span>
		</nav>
		<section aria-labelledby="account-status-title" class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-cyan-300">Local account</p>
			<h1 id="account-status-title" class="text-3xl font-bold tracking-tight text-white">{ user.DisplayName }</h1>
			<dl class="mt-8 grid gap-4 sm:grid-cols-2">
				<div><dt class="text-sm text-slate-400">Role</dt><dd class="font-semibold text-white">{ user.RoleLabel }</dd></div>
				<div><dt class="text-sm text-slate-400">Status</dt><dd class="font-semibold text-white">{ user.StatusLabel }</dd></div>
				<div><dt class="text-sm text-slate-400">Joined</dt><dd class="text-slate-200">{ user.CreatedAt }</dd></div>
				<div><dt class="text-sm text-slate-400">Last local login</dt><dd class="text-slate-200">{ user.LastLoginAt }</dd></div>
				if user.SuspendedAt != "" {
					<div><dt class="text-sm text-slate-400">Suspended at</dt><dd class="text-slate-200">{ user.SuspendedAt }</dd></div>
				}
				if user.SuspendedUntil != "" {
					<div><dt class="text-sm text-slate-400">Suspended until</dt><dd class="text-slate-200">{ user.SuspendedUntil }</dd></div>
				}
				if user.MutedUntil != "" {
					<div><dt class="text-sm text-slate-400">Muted until</dt><dd class="text-slate-200">{ user.MutedUntil }</dd></div>
				}
				if user.SuspensionReason != "" {
					<div class="sm:col-span-2"><dt class="text-sm text-slate-400">Suspension reason</dt><dd class="break-words text-slate-200">{ user.SuspensionReason }</dd></div>
				}
			</dl>
			<form method="post" action={ user.ActionURL } hx-post={ user.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-8 grid gap-3 rounded-lg border border-amber-800/70 bg-amber-950/20 p-4">
				<input type="hidden" name="_csrf" value={ user.CSRFToken }/>
				<label class="grid gap-2 font-semibold text-amber-100">
					Moderation reason
					<input type="text" name="reason" required maxlength="500" autocomplete="off" class="rounded-md border border-amber-800 bg-slate-950 px-3 py-2 text-white"/>
				</label>
				<button type="submit" class="w-fit rounded-md border border-amber-700 px-4 py-2 font-semibold text-amber-100 hover:border-amber-500">{ user.SubmitLabel }</button>
			</form>
			for _, control := range user.Extended {
				@extendedModerationForm(control)
			}
		</section>
	</main>
}

templ publishingFormContent(view pageView, form publishingFormView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-3xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		@publishingFormSection(form)
	</main>
}

templ publishingFormSection(form publishingFormView) {
		<section aria-labelledby="publishing-title" class="mt-8 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<h1 id="publishing-title" class="text-3xl font-bold tracking-tight text-white">{ form.Heading }</h1>
			if form.FormError != "" {
				<p role="alert" class="mt-4 rounded-md border border-rose-900/70 bg-rose-950/40 p-3 text-rose-200">{ form.FormError }</p>
			}
			<form method="post" action={ form.ActionURL } hx-post={ form.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-8 grid gap-6">
				<input type="hidden" name="_csrf" value={ form.CSRFToken }/>
				if form.Reply {
					<input type="hidden" name="parent_post_id" value={ form.ParentPostID }/>
				}
				if form.Edit {
					<input type="hidden" name="revision" value={ form.Revision }/>
				}
				if !form.Reply && !form.Edit {
					<input type="hidden" name="area" value={ form.AreaSlug }/>
					<label class="grid gap-2 font-semibold text-slate-200">
						Topic title
						<input name="title" value={ form.Title } required maxlength="200"
							if form.TitleError != "" {
								aria-invalid="true"
							}
							class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white"/>
					</label>
					if form.TitleError != "" {
						<p role="alert" class="text-sm text-rose-300">{ form.TitleError }</p>
					}
				}
				<div data-markdown-editor class="grid gap-2">
					<label for="markdown-body" class="font-semibold text-slate-200">Markdown body</label>
					<div data-markdown-toolbar hidden role="group" aria-label="Markdown formatting" class="flex flex-wrap gap-2">
						@markdownToolbarButtons()
					</div>
					<textarea id="markdown-body" name="markdown" required maxlength="65536" rows="14"
						if form.MarkdownError != "" {
							aria-invalid="true"
						}
						class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-white">{ form.Markdown }</textarea>
				</div>
				if form.MarkdownError != "" {
					<p role="alert" class="text-sm text-rose-300">{ form.MarkdownError }</p>
				}
				if form.ShowPreview {
					<section aria-labelledby="preview-title" class="rounded-lg border border-slate-700 bg-slate-950/60 p-5">
						<h2 id="preview-title" class="text-xl font-semibold text-white">Sanitized preview</h2>
						<div class="rendered-post mt-4 min-w-0 max-w-full space-y-4 break-words leading-7 text-slate-200">
							@form.PreviewBody.Component()
						</div>
					</section>
				}
				<div class="flex flex-wrap gap-4">
					<button type="submit" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200">
						if form.Edit {
							Save edit
						} else {
							Publish
						}
					</button>
					<button type="submit" formaction={ form.PreviewURL } hx-post={ form.PreviewURL } hx-target="#main-content" hx-swap="outerHTML" class="rounded-md border border-cyan-700 px-4 py-2 font-semibold text-cyan-100 hover:border-cyan-500">Preview</button>
					<a href={ form.CancelURL } hx-get={ form.CancelURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md border border-slate-700 px-4 py-2 font-semibold text-slate-200">Cancel</a>
				</div>
			</form>
		</section>
}

templ discoverySearchPage(view pageView, search discoverySearchPageView) {
	@document(view, discoverySearchContent(view, search))
}

templ discoverySearchContent(view pageView, search discoverySearchPageView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-4 text-sm"><a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">Board index</a><span aria-hidden="true" class="px-2 text-slate-500">›</span><span aria-current="page">Search</span></nav>
		<section aria-labelledby="search-title" class="rounded border border-slate-700 bg-slate-900 p-4 sm:p-6">
			<h1 id="search-title" class="text-2xl font-bold text-white">Search discussions</h1>
			<p class="mt-2 text-sm text-slate-400">Search text or an exact author ID. Text supports terms, quoted phrases, OR, and unary -.</p>
			if search.ValidationErr != "" {
				<p role="alert" class="mt-4 rounded border border-rose-900 bg-rose-950/40 p-3 text-rose-200">{ search.ValidationErr }</p>
			}
			<form method="get" action={ search.ActionURL } hx-get={ search.ActionURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="mt-5 grid gap-4 md:grid-cols-2">
				<label class="grid gap-1 font-semibold">Search text<input name="q" value={ search.Query } maxlength="256" class="rounded border border-slate-700 bg-slate-950 px-3 py-2 text-white"/></label>
				<label class="grid gap-1 font-semibold">Author ID<input name="author" value={ search.Author } inputmode="numeric" pattern="[1-9][0-9]*" class="rounded border border-slate-700 bg-slate-950 px-3 py-2 text-white"/></label>
				<label class="grid gap-1 font-semibold">Area slug<input name="area" value={ search.Area } pattern="[a-z0-9]+(-[a-z0-9]+)*" class="rounded border border-slate-700 bg-slate-950 px-3 py-2 text-white"/></label>
				<div class="grid grid-cols-2 gap-3"><label class="grid gap-1 font-semibold">From (UTC)<input type="date" name="from" value={ search.From } class="rounded border border-slate-700 bg-slate-950 px-3 py-2 text-white"/></label><label class="grid gap-1 font-semibold">To (UTC)<input type="date" name="to" value={ search.To } class="rounded border border-slate-700 bg-slate-950 px-3 py-2 text-white"/></label></div>
				<button type="submit" class="w-fit rounded bg-blue-600 px-4 py-2 font-bold text-white hover:bg-blue-500">Search</button>
			</form>
		</section>
		<section aria-labelledby="search-results-title" class="mt-6">
			<h2 id="search-results-title" class="text-xl font-bold text-white">Results</h2>
			<p class="mt-1 text-sm text-slate-400">{ search.ScopeLabel }</p>
			if len(search.Results) == 0 {
				<p role="status" aria-live="polite" class="mt-4 rounded border border-dashed border-slate-700 p-5 text-slate-300">No authorized matches were found.</p>
			} else {
				<ol class="mt-4 grid gap-3">
					for _, result := range search.Results {
						<li>
							<article class="rounded border border-slate-700 bg-slate-900 p-4">
								<p class="text-xs font-bold uppercase tracking-wide text-cyan-300">{ result.KindLabel }</p>
								<h3 class="mt-1 font-bold"><a href={ result.URL } hx-get={ result.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">{ result.TopicTitle }</a></h3>
								<p class="mt-1 text-sm text-slate-400">{ result.AreaName } · { result.AuthorName } · { result.Created }</p>
								if result.TopicURL != "" {
									<p class="mt-1 text-sm"><a href={ result.TopicURL } hx-get={ result.TopicURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">View topic</a></p>
								}
								if result.Excerpt != "" {
									<p class="mt-3 break-words text-slate-200">{ result.Excerpt }</p>
								}
							</article>
						</li>
					}
				</ol>
			}
		</section>
		if search.PreviousURL != "" || search.NextURL != "" {
			<nav aria-label="Search result pages" class="mt-6 flex gap-3">
				if search.PreviousURL != "" {
					<a href={ search.PreviousURL } hx-get={ search.PreviousURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded border border-slate-700 px-3 py-2 font-semibold text-blue-300">Previous</a>
				}
				if search.NextURL != "" {
					<a href={ search.NextURL } hx-get={ search.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded border border-slate-700 px-3 py-2 font-semibold text-blue-300">Next</a>
				}
			</nav>
		}
	</main>
}

templ discoveryActivityPage(view pageView, activity discoveryActivityPageView) {
	@document(view, discoveryActivityContent(view, activity))
}

templ discoveryActivityContent(view pageView, activity discoveryActivityPageView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-4 text-sm"><a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">Board index</a><span aria-hidden="true" class="px-2 text-slate-500">›</span><span aria-current="page">Recent activity</span></nav>
		<h1 id="activity-title" class="text-2xl font-bold text-white">Recent activity</h1>
		if len(activity.Results) == 0 {
			<p role="status" aria-live="polite" class="mt-4 rounded border border-dashed border-slate-700 p-5 text-slate-300">No more authorized activity is available.</p>
		} else {
			<ol aria-labelledby="activity-title" class="mt-4 grid gap-3">
				for _, result := range activity.Results {
					<li><article class="rounded border border-slate-700 bg-slate-900 p-4"><h2 class="font-bold"><a href={ result.URL } hx-get={ result.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">{ result.TopicTitle }</a></h2><p class="mt-1 text-sm text-slate-400">{ result.AreaName } · { result.AuthorName } · { result.Created }</p></article></li>
				}
			</ol>
		}
		if activity.NextURL != "" {
			<nav aria-label="Activity pages" class="mt-6"><a href={ activity.NextURL } hx-get={ activity.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded border border-slate-700 px-3 py-2 font-semibold text-blue-300">Older activity</a></nav>
		}
	</main>
}

templ discoveryDirectPostPage(view pageView, post discoveryDirectPostView) {
	@document(view, discoveryDirectPostContent(view, post))
}

templ discoveryDirectPostContent(view pageView, post discoveryDirectPostView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-4xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12">
		<nav aria-label="Breadcrumb" class="mb-4 text-sm"><a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">Board index</a><span aria-hidden="true" class="px-2 text-slate-500">›</span><a href={ post.AreaURL } hx-get={ post.AreaURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">{ post.AreaName }</a><span aria-hidden="true" class="px-2 text-slate-500">›</span><a href={ post.TopicURL } hx-get={ post.TopicURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-blue-300 hover:underline">{ post.TopicTitle }</a><span aria-hidden="true" class="px-2 text-slate-500">›</span><span aria-current="page">Post</span></nav>
		<article aria-labelledby="direct-post-author" class="rounded border border-slate-700 bg-slate-900">
			<header class="border-b border-slate-700 bg-slate-800 p-4">
				<h1 id="direct-post-author" class="font-bold text-blue-100">{ post.AuthorName }</h1>
				<p class="mt-1 text-sm text-slate-400">Posted { post.Created }</p>
				if post.Edited != "" {
					<p class="mt-1 text-sm text-slate-400">{ post.Edited }</p>
				}
				<a href={ post.Permalink } class="mt-2 inline-block text-sm text-blue-300 hover:underline">Permalink</a>
			</header>
			<div class="rendered-post min-w-0 max-w-full space-y-4 break-words p-4 leading-7 text-slate-200">@post.Body.Component()</div>
		</article>
	</main>
}

templ errorPage(view pageView, status int, heading, message string) {
	@document(view, errorContent(view, status, heading, message))
}

templ errorContent(view pageView, status int, heading, message string) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-500">/</span>
			<span aria-current="page" class="text-slate-400">Error { status }</span>
		</nav>
		<section aria-labelledby="error-title" aria-live="assertive" class="rounded-xl border border-rose-900/70 bg-slate-900 p-6 sm:p-8">
			<p class="text-sm font-semibold text-rose-300">Error { status }</p>
			<h1 id="error-title" class="mt-2 text-3xl font-bold tracking-tight text-white">{ heading }</h1>
			<p class="mt-4 max-w-2xl leading-7 text-slate-300">{ message }</p>
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="mt-8 inline-flex rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Return to areas</a>
		</section>
	</main>
}
