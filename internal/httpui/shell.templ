package httpui

templ document(view pageView, content templ.Component) {
	<!doctype html>
	<html lang="en" class="h-full bg-slate-950">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content={ htmxConfiguration }/>
			<title>{ view.Title } · { view.SiteName }</title>
			if view.CanonicalURL != "" {
				<link rel="canonical" href={ view.CanonicalURL }/>
			}
			<link rel="stylesheet" href={ view.StylesheetURL }/>
		</head>
		<body class="min-h-full bg-slate-950 text-slate-100 antialiased">
			<a href="#main-content" class="sr-only fixed left-4 top-4 z-50 rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 focus:not-sr-only focus:outline-2 focus:outline-offset-2 focus:outline-cyan-100">Skip to main content</a>
			<header class="border-b border-slate-800 bg-slate-950/95">
				<div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
					<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="w-fit rounded-sm text-xl font-bold tracking-tight text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{ view.SiteName }</a>
					<nav aria-label="Primary" class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
						<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm font-medium text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Areas</a>
					</nav>
				</div>
			</header>
			@content
			<footer class="border-t border-slate-800">
				<div class="mx-auto max-w-6xl px-4 py-6 text-sm text-slate-400 sm:px-6 lg:px-8">
					GOTTH Board · a simple place for durable community discussion
				</div>
			</footer>
			<script src={ view.HTMXURL } defer></script>
		</body>
	</html>
}

templ areaIndexPageWithAreas(view pageView, areas []areaIndexItem) {
	@document(view, areaIndexContentWithAreas(view, areas))
}

templ areaIndexContentWithAreas(view pageView, areas []areaIndexItem) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm text-slate-400">
			<ol>
				<li><span aria-current="page">Areas</span></li>
			</ol>
		</nav>
		<section aria-labelledby="areas-title" class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-cyan-300">Community index</p>
			<h1 id="areas-title" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Discussion areas</h1>
			if len(areas) == 0 {
				<p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">No public discussion areas are available yet.</p>
				<div role="status" aria-live="polite" class="mt-8 rounded-lg border border-dashed border-slate-700 bg-slate-950/60 p-6 text-slate-300">
					This community is ready for its first discussion area.
				</div>
			} else {
				<p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">Browse the discussion areas available to you.</p>
				<ul class="mt-8 grid gap-4">
					for _, area := range areas {
						<li class="rounded-lg border border-slate-700 bg-slate-950/60 p-6">
							<h2 class="text-xl font-semibold">
								<a href={ area.URL } hx-get={ area.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{ area.Name }</a>
							</h2>
							if area.Description != "" {
								<p class="mt-2 leading-7 text-slate-300">{ area.Description }</p>
							}
						</li>
					}
				</ul>
			}
		</section>
	</main>
}

templ areaTopicListPage(view pageView, area areaTopicListView) {
	@document(view, areaTopicListContent(view, area))
}

templ areaTopicListContent(view pageView, area areaTopicListView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-600">/</span>
			<span aria-current="page" class="text-slate-400">{ area.Name }</span>
		</nav>
		<section aria-labelledby="area-title" class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-cyan-300">Discussion area</p>
			<h1 id="area-title" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{ area.Name }</h1>
			if area.Description != "" {
				<p class="mt-4 max-w-2xl text-base leading-7 text-slate-300">{ area.Description }</p>
			}
			if area.NewTopicURL != "" {
				<a href={ area.NewTopicURL } hx-get={ area.NewTopicURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="mt-6 inline-flex rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200">New topic</a>
			}
			if len(area.Topics) == 0 {
				<div role="status" aria-live="polite" class="mt-8 rounded-lg border border-dashed border-slate-700 bg-slate-950/60 p-6 text-slate-300">
					No topics have been published in this area yet.
				</div>
			} else {
				<p class="mt-4 text-sm text-slate-400">Page { area.Number } · { area.TotalTopics } topics available to you</p>
				<ul class="mt-8 grid gap-4">
					for _, topic := range area.Topics {
						<li class="rounded-lg border border-slate-700 bg-slate-950/60 p-6">
							<div class="flex flex-wrap items-center gap-3 text-sm">
								if topic.Pinned {
									<span class="rounded-sm border border-slate-700 px-2 py-2 font-semibold text-cyan-300">Pinned</span>
								}
								<span class="text-slate-400">{ topic.StateLabel }</span>
							</div>
							<h2 class="mt-4 text-xl font-semibold text-white">
								<a href={ topic.URL } hx-get={ topic.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{ topic.Title }</a>
							</h2>
							<p class="mt-2 text-sm text-slate-400">Started by { topic.Author } · { topic.ReplyLabel } · Last activity { topic.LastActivity }</p>
						</li>
					}
				</ul>
				if area.PreviousURL != "" || area.NextURL != "" {
					<nav aria-label="Topic pages" class="mt-8 flex flex-wrap items-center gap-4">
						if area.PreviousURL != "" {
							<a href={ area.PreviousURL } hx-get={ area.PreviousURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Previous</a>
						}
						if area.NextURL != "" {
							<a href={ area.NextURL } hx-get={ area.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Next</a>
						}
					</nav>
				}
			}
		</section>
	</main>
}

templ topicPostListPage(view pageView, topic topicPostPageView) {
	@document(view, topicPostListContent(view, topic))
}

templ topicPostListContent(view pageView, topic topicPostPageView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-600">/</span>
			<a href={ topic.AreaURL } hx-get={ topic.AreaURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">{ topic.AreaName }</a>
			<span aria-hidden="true" class="px-2 text-slate-600">/</span>
			<span aria-current="page" class="text-slate-400">{ topic.Title }</span>
		</nav>
		<section aria-labelledby="topic-title" class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<div class="flex flex-wrap items-center gap-3 text-sm">
				if topic.Pinned {
					<span class="rounded-sm border border-slate-700 px-2 py-1 font-semibold text-cyan-300">Pinned</span>
				}
				<span class="text-slate-400">{ topic.StateLabel }</span>
			</div>
			<h1 id="topic-title" class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl">{ topic.Title }</h1>
			<p class="mt-3 text-sm text-slate-400">Started by { topic.Author } · { topic.Started }</p>
			<p class="mt-2 text-sm text-slate-400">Page { topic.Number } · { topic.TotalPosts } visible posts</p>
			for _, control := range topic.Moderation {
				<form method="post" action={ control.ActionURL } hx-post={ control.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-6 grid max-w-xl gap-3 rounded-lg border border-amber-800/70 bg-amber-950/20 p-4">
					<input type="hidden" name="_csrf" value={ control.CSRFToken }/>
					<label class="grid gap-2 font-semibold text-amber-100">
						Moderation reason
						<input type="text" name="reason" required maxlength="2000" autocomplete="off" class="rounded-md border border-amber-800 bg-slate-950 px-3 py-2 text-white"/>
					</label>
					<button type="submit" class="w-fit rounded-md border border-amber-700 px-4 py-2 font-semibold text-amber-100 hover:border-amber-500">{ control.SubmitLabel }</button>
				</form>
			}
		</section>
		if len(topic.Posts) == 0 {
			<div role="status" aria-live="polite" class="mt-6 rounded-lg border border-dashed border-slate-700 bg-slate-950/60 p-6 text-slate-300">
				No visible posts are available in this topic yet.
			</div>
		} else {
			<ol class="mt-6 grid gap-6">
				for _, post := range topic.Posts {
					<li>
						<article id={ post.Anchor } aria-labelledby={ post.Anchor + "-author" } class="scroll-mt-6 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
							<header class="flex flex-wrap items-baseline justify-between gap-3 border-b border-slate-800 pb-4">
								<div>
									<h2 id={ post.Anchor + "-author" } class="font-semibold text-white">{ post.Author }</h2>
									<p class="mt-1 text-sm text-slate-400">
										if post.AuthorStatusURL != "" {
											<a href={ post.AuthorStatusURL } hx-get={ post.AuthorStatusURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200 hover:text-cyan-100">Account status</a>
											<span> · </span>
										}
										Posted { post.Created }
										if post.Edited != "" {
											<span> · { post.Edited }</span>
										}
										if post.EditURL != "" {
											<span> · <a href={ post.EditURL } hx-get={ post.EditURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200 hover:text-cyan-100">Edit</a></span>
										}
										if post.DeleteURL != "" {
											<span> ·</span>
											<form method="post" action={ post.DeleteURL } hx-post={ post.DeleteURL } hx-target="#main-content" hx-swap="outerHTML" class="inline">
												<input type="hidden" name="_csrf" value={ post.CSRFToken }/>
												<input type="hidden" name="revision" value={ post.Revision }/>
												<button type="submit" class="text-rose-300 hover:text-rose-200">Delete</button>
											</form>
										}
									</p>
								</div>
								<a href={ post.Permalink } class="rounded-sm text-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Post #{ post.Number }</a>
							</header>
							<div class="mt-6 space-y-4 break-words leading-7 text-slate-200">
								@post.Body.Component()
							</div>
						</article>
					</li>
				}
			</ol>
		}
		if topic.PreviousURL != "" || topic.NextURL != "" {
			<nav aria-label="Post pages" class="mt-8 flex flex-wrap items-center gap-4">
				if topic.PreviousURL != "" {
					<a href={ topic.PreviousURL } hx-get={ topic.PreviousURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Previous</a>
				}
				if topic.NextURL != "" {
					<a href={ topic.NextURL } hx-get={ topic.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Next</a>
				}
			</nav>
		}
		if topic.ShowReply {
			@publishingFormSection(topic.ReplyForm)
		}
	</main>
}

templ publishingFormPage(view pageView, form publishingFormView) {
	@document(view, publishingFormContent(view, form))
}

templ moderationUserPage(view pageView, user moderationUserView) {
	@document(view, moderationUserContent(view, user))
}

templ moderationUserContent(view pageView, user moderationUserView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-3xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-600">/</span>
			<span aria-current="page" class="text-slate-400">Account status</span>
		</nav>
		<section aria-labelledby="account-status-title" class="rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-cyan-300">Local account</p>
			<h1 id="account-status-title" class="text-3xl font-bold tracking-tight text-white">{ user.DisplayName }</h1>
			<dl class="mt-8 grid gap-4 sm:grid-cols-2">
				<div><dt class="text-sm text-slate-400">Role</dt><dd class="font-semibold text-white">{ user.RoleLabel }</dd></div>
				<div><dt class="text-sm text-slate-400">Status</dt><dd class="font-semibold text-white">{ user.StatusLabel }</dd></div>
				<div><dt class="text-sm text-slate-400">Joined</dt><dd class="text-slate-200">{ user.CreatedAt }</dd></div>
				<div><dt class="text-sm text-slate-400">Last local login</dt><dd class="text-slate-200">{ user.LastLoginAt }</dd></div>
				if user.SuspendedAt != "" {
					<div><dt class="text-sm text-slate-400">Suspended at</dt><dd class="text-slate-200">{ user.SuspendedAt }</dd></div>
				}
				if user.SuspendedUntil != "" {
					<div><dt class="text-sm text-slate-400">Suspended until</dt><dd class="text-slate-200">{ user.SuspendedUntil }</dd></div>
				}
				if user.MutedUntil != "" {
					<div><dt class="text-sm text-slate-400">Muted until</dt><dd class="text-slate-200">{ user.MutedUntil }</dd></div>
				}
				if user.SuspensionReason != "" {
					<div class="sm:col-span-2"><dt class="text-sm text-slate-400">Suspension reason</dt><dd class="break-words text-slate-200">{ user.SuspensionReason }</dd></div>
				}
			</dl>
			<form method="post" action={ user.ActionURL } hx-post={ user.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-8 grid gap-3 rounded-lg border border-amber-800/70 bg-amber-950/20 p-4">
				<input type="hidden" name="_csrf" value={ user.CSRFToken }/>
				<label class="grid gap-2 font-semibold text-amber-100">
					Moderation reason
					<input type="text" name="reason" required maxlength="500" autocomplete="off" class="rounded-md border border-amber-800 bg-slate-950 px-3 py-2 text-white"/>
				</label>
				<button type="submit" class="w-fit rounded-md border border-amber-700 px-4 py-2 font-semibold text-amber-100 hover:border-amber-500">{ user.SubmitLabel }</button>
			</form>
		</section>
	</main>
}

templ publishingFormContent(view pageView, form publishingFormView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-3xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		@publishingFormSection(form)
	</main>
}

templ publishingFormSection(form publishingFormView) {
		<section aria-labelledby="publishing-title" class="mt-8 rounded-xl border border-slate-800 bg-slate-900 p-6 shadow-lg shadow-black/20 sm:p-8">
			<h1 id="publishing-title" class="text-3xl font-bold tracking-tight text-white">{ form.Heading }</h1>
			if form.FormError != "" {
				<p role="alert" class="mt-4 rounded-md border border-rose-900/70 bg-rose-950/40 p-3 text-rose-200">{ form.FormError }</p>
			}
			<form method="post" action={ form.ActionURL } hx-post={ form.ActionURL } hx-target="#main-content" hx-swap="outerHTML" class="mt-8 grid gap-6">
				<input type="hidden" name="_csrf" value={ form.CSRFToken }/>
				if form.Edit {
					<input type="hidden" name="revision" value={ form.Revision }/>
				}
				if !form.Reply && !form.Edit {
					<input type="hidden" name="area" value={ form.AreaSlug }/>
					<label class="grid gap-2 font-semibold text-slate-200">
						Topic title
						<input name="title" value={ form.Title } required maxlength="200"
							if form.TitleError != "" {
								aria-invalid="true"
							}
							class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-white"/>
					</label>
					if form.TitleError != "" {
						<p role="alert" class="text-sm text-rose-300">{ form.TitleError }</p>
					}
				}
				<label class="grid gap-2 font-semibold text-slate-200">
					Markdown body
					<textarea name="markdown" required maxlength="65536" rows="14"
						if form.MarkdownError != "" {
							aria-invalid="true"
						}
						class="rounded-md border border-slate-700 bg-slate-950 px-3 py-2 font-mono text-sm text-white">{ form.Markdown }</textarea>
				</label>
				if form.MarkdownError != "" {
					<p role="alert" class="text-sm text-rose-300">{ form.MarkdownError }</p>
				}
				if form.ShowPreview {
					<section aria-labelledby="preview-title" class="rounded-lg border border-slate-700 bg-slate-950/60 p-5">
						<h2 id="preview-title" class="text-xl font-semibold text-white">Sanitized preview</h2>
						<div class="mt-4 space-y-4 break-words leading-7 text-slate-200">
							@form.PreviewBody.Component()
						</div>
					</section>
				}
				<div class="flex flex-wrap gap-4">
					<button type="submit" class="rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200">
						if form.Edit {
							Save edit
						} else {
							Publish
						}
					</button>
					<button type="submit" formaction={ form.PreviewURL } class="rounded-md border border-cyan-700 px-4 py-2 font-semibold text-cyan-100 hover:border-cyan-500">Preview</button>
					<a href={ form.CancelURL } class="rounded-md border border-slate-700 px-4 py-2 font-semibold text-slate-200">Cancel</a>
				</div>
			</form>
		</section>
}

templ errorPage(view pageView, status int, heading, message string) {
	@document(view, errorContent(view, status, heading, message))
}

templ errorContent(view pageView, status int, heading, message string) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Breadcrumb" class="mb-6 text-sm">
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="rounded-sm text-cyan-200 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Areas</a>
			<span aria-hidden="true" class="px-2 text-slate-600">/</span>
			<span aria-current="page" class="text-slate-400">Error { status }</span>
		</nav>
		<section aria-labelledby="error-title" aria-live="assertive" class="rounded-xl border border-rose-900/70 bg-slate-900 p-6 sm:p-8">
			<p class="text-sm font-semibold text-rose-300">Error { status }</p>
			<h1 id="error-title" class="mt-2 text-3xl font-bold tracking-tight text-white">{ heading }</h1>
			<p class="mt-4 max-w-2xl leading-7 text-slate-300">{ message }</p>
			<a href={ view.HomeURL } hx-get={ view.HomeURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="mt-8 inline-flex rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-300">Return to areas</a>
		</section>
	</main>
}
