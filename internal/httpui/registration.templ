package httpui

templ registrationPage(view pageView, presentation registrationPageView) {
	@document(view, registrationContent(presentation))
}

templ registrationContent(presentation registrationPageView) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-3xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12">
		<section aria-labelledby="registration-title" class="rounded-xl border border-slate-800 bg-slate-900 p-5 shadow-lg shadow-black/20 sm:p-8">
			<h1 id="registration-title" class="text-3xl font-bold text-white">{ presentation.Heading }</h1>
			<p class="mt-4 text-slate-300">{ presentation.Message }</p>
			if presentation.FlowURL != "" {
				<a class="mt-6 inline-flex min-h-11 items-center rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300" href={ presentation.FlowURL }>{ presentation.LinkLabel }</a>
			}
		</section>
	</main>
}
