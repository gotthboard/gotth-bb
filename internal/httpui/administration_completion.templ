package httpui

import "strconv"

templ administrationPage(view pageView, body templ.Component) {
	@document(view, administrationContent(view, body))
}

templ administrationContent(view pageView, body templ.Component) {
	<main id="main-content" tabindex="-1" class="mx-auto min-h-[60vh] w-full max-w-6xl px-4 py-8 focus:outline-none sm:px-6 sm:py-12 lg:px-8">
		<nav aria-label="Administration" class="mb-6 flex flex-wrap gap-4 text-sm">
			<a href={ view.AdminURL } hx-get={ view.AdminURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Overview</a>
			<a href={ view.AdminURL + "/accounts" } hx-get={ view.AdminURL + "/accounts" } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Accounts</a>
			<a href={ view.AdminURL + "/groups" } hx-get={ view.AdminURL + "/groups" } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Groups</a>
			<a href={ view.AdminURL + "/areas" } hx-get={ view.AdminURL + "/areas" } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Areas</a>
			if view.RegistrationsURL != "" {
				<a href={ view.RegistrationsURL } hx-get={ view.RegistrationsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Registrations</a>
			}
			if view.InvitationsURL != "" {
				<a href={ view.InvitationsURL } hx-get={ view.InvitationsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Invitations</a>
			}
			if view.ControlURL != "" {
				<a href={ view.ControlURL } hx-get={ view.ControlURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Control</a>
			}
			if view.EmailURL != "" {
				<a href={ view.EmailURL } hx-get={ view.EmailURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Email</a>
			}
			<a href={ view.AdminURL + "/settings" } hx-get={ view.AdminURL + "/settings" } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true" class="text-cyan-200">Settings</a>
		</nav>
		@body
	</main>
}

templ administrationInvitationsBody(page administrationInvitationsView) {
	<section aria-labelledby="invitations-title">
		<h1 id="invitations-title" class="text-3xl font-bold text-white">Invitations</h1>
		<p class="mt-3 max-w-3xl text-slate-300">Create one single-use invitation. The private link is shown once and is never stored by Board.</p>
		if page.OneTimeURL != "" {
			<div role="status" class="mt-6 rounded-lg border border-cyan-800 bg-cyan-950/30 p-4"><p class="font-semibold text-cyan-100">Copy this link now. It will not be shown again.</p><a class="mt-2 block break-all text-cyan-200 underline" href={ page.OneTimeURL }>{ page.OneTimeURL }</a></div>
		}
		<form method="post" action={ page.ActionURL } hx-post={ page.ActionURL } class="mt-8 grid min-w-0 gap-5 rounded-xl border border-slate-800 bg-slate-900 p-4 sm:p-6">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<input type="hidden" name="idempotency_key" value={ page.IdempotencyKey }/>
			<input type="hidden" name="expires_reference" value={ page.ExpiryReference }/>
			<label class="grid gap-2 text-sm font-semibold">Email<input required type="email" name="email" maxlength="320" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
			<label class="grid gap-2 text-sm font-semibold">Display name <span class="text-xs font-normal text-slate-400">Optional</span><input name="display_name" maxlength="80" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
			<label class="grid gap-2 text-sm font-semibold">Expires in minutes<input required type="number" min="16" max="10079" value="1440" name="expires_minutes" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
			<label class="grid gap-2 text-sm font-semibold">
				Delivery
				<select name="delivery" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base">
					<option value="none">Show link only</option>
					if page.SMTPConfigured {
						<option value="email">Email link</option>
					}
				</select>
			</label>
			<label class="grid gap-2 text-sm font-semibold">Audit reason<input required name="reason" maxlength="2000" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
			<button class="min-h-11 w-fit rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Create invitation</button>
		</form>
		<h2 class="mt-10 text-2xl font-bold text-white">Recent invitation operations</h2>
		<ul class="mt-5 grid gap-4">
			for _, invitation := range page.Invitations {
				<li class="rounded-lg border border-slate-800 bg-slate-900 p-4">
					<h3 class="font-semibold text-white">{ invitation.Name }</h3>
					<p class="mt-1 text-sm text-slate-300">{ invitation.Status } · delivery { invitation.Delivery } · expires { invitation.ExpiresAt }</p>
					if invitation.Failure != "" {
						<p class="mt-2 text-sm text-amber-200">{ invitation.Failure }</p>
					}
					if invitation.RevokeURL != "" {
						<form method="post" action={ invitation.RevokeURL } hx-post={ invitation.RevokeURL } class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
							<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
							<label class="grid gap-2 text-sm font-semibold">Revocation reason<input required name="reason" maxlength="2000" class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
							<button class="min-h-11 rounded-md border border-rose-700 px-4 py-2 font-semibold text-rose-200">Revoke</button>
						</form>
					}
				</li>
			}
		</ul>
		if page.More {
			<p class="mt-4 text-sm text-amber-200">More invitation operations exist than this bounded page can show.</p>
		}
	</section>
}

templ administrationRegistrationsBody(page administrationRegistrationsView) {
	<section aria-labelledby="registrations-title">
		<h1 id="registrations-title" class="text-3xl font-bold text-white">Pending registrations</h1>
		<p class="mt-3 max-w-3xl text-slate-300">Approve or reject verified identities waiting for Board access. Every decision requires an audit reason.</p>
		if len(page.Registrations) == 0 {
			<p class="mt-8 rounded-lg border border-slate-800 bg-slate-900 p-5 text-slate-300">No registrations are waiting.</p>
		}
		<ul class="mt-6 grid gap-4">
			for _, pending := range page.Registrations {
				<li class="min-w-0 rounded-lg border border-slate-800 bg-slate-900 p-4 sm:p-5">
					<h2 class="break-words text-lg font-semibold text-white">{ pending.DisplayName }</h2>
					<p class="mt-1 break-all text-sm text-slate-300">{ pending.VerifiedEmail }</p>
					<p class="mt-2 text-sm text-slate-400">{ pending.Status } · received { pending.IntakeAt }</p>
					if pending.Failure != "" {
						<p class="mt-2 text-sm text-amber-200">Last reconciliation: { pending.Failure }</p>
					}
					<div class="mt-5 grid gap-4 lg:grid-cols-2">
						@administrationRegistrationDecisionForm(pending.ApproveURL, "Approve", pending.Revision, page.CSRFToken, "bg-cyan-300 text-slate-950")
						@administrationRegistrationDecisionForm(pending.RejectURL, "Reject", pending.Revision, page.CSRFToken, "border border-rose-700 text-rose-100")
					</div>
				</li>
			}
		</ul>
		if page.NextURL != "" {
			<a class="mt-6 inline-flex min-h-11 items-center rounded-md border border-slate-700 px-4 py-2 font-semibold text-cyan-200" href={ page.NextURL } hx-get={ page.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Next registrations</a>
		}
		<h2 class="mt-10 text-2xl font-bold text-white">Unrecorded pending identities</h2>
		if page.RemoteUnavailable {
			<p class="mt-4 rounded-lg border border-amber-900 bg-amber-950/20 p-4 text-amber-100">Authentik pending identities are temporarily unavailable. The local queue above remains authoritative.</p>
		} else if len(page.Orphans) == 0 {
			<p class="mt-4 text-slate-300">No unrecorded pending identities were found.</p>
		} else {
			<ul class="mt-5 grid gap-4">
				for _, orphan := range page.Orphans {
					<li class="min-w-0 rounded-lg border border-slate-800 bg-slate-900 p-4 sm:p-5">
						<h3 class="break-words font-semibold text-white">{ orphan.DisplayName }</h3>
						<p class="mt-1 break-all text-sm text-slate-300">{ orphan.VerifiedEmail }</p>
						<form method="post" action={ orphan.AdoptURL } hx-post={ orphan.AdoptURL } class="mt-4 grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
							<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
							<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Audit reason<input required name="reason" maxlength="2000" autocomplete="off" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white"/></label>
							<button class="min-h-11 w-fit rounded-md border border-cyan-700 px-4 py-2 font-semibold text-cyan-100">Add to pending queue</button>
						</form>
					</li>
				}
			</ul>
		}
		if page.RemoteMore {
			<p class="mt-4 text-sm text-amber-200">More remote pending identities exist than this bounded page can show.</p>
		}
	</section>
}

templ administrationRegistrationDecisionForm(action, label, revision, csrf, buttonClass string) {
	<form method="post" action={ action } hx-post={ action } class="grid min-w-0 gap-3 rounded-md border border-slate-700 p-4">
		<input type="hidden" name="_csrf" value={ csrf }/>
		<input type="hidden" name="revision" value={ revision }/>
		<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Audit reason<input required name="reason" maxlength="2000" autocomplete="off" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
		<button class={ "min-h-11 w-fit rounded-md px-4 py-2 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300 " + buttonClass }>{ label }</button>
	</form>
}

templ administrationDashboardBody(page administrationDashboardView) {
	<section aria-labelledby="administration-title">
		<p class="text-sm font-semibold uppercase tracking-wider text-cyan-300">Administration</p>
		<h1 id="administration-title" class="mt-2 text-3xl font-bold text-white">Board administration</h1>
		<p class="mt-3 text-slate-300">Exact counts observed at { page.ObservedAt }.</p>
		<dl class="mt-8 grid gap-4 sm:grid-cols-2">
			@administrationMetric("Accounts", page.Users)
			@administrationMetric("Active accounts", page.ActiveUsers)
			@administrationMetric("Suspended accounts", page.SuspendedUsers)
			@administrationMetric("Members", page.Members)
			@administrationMetric("Moderators", page.Moderators)
			@administrationMetric("Administrators", page.Administrators)
			@administrationMetric("Topics", page.Topics)
			@administrationMetric("Visible posts", page.Posts)
			@administrationMetric("Open reports", page.OpenReports)
			@administrationMetric("Reports in review", page.InReviewReports)
		</dl>
	</section>
}

templ administrationMetric(label string, value int64) {
	<div class="rounded-lg border border-slate-800 bg-slate-900 p-5"><dt class="text-sm text-slate-400">{ label }</dt><dd class="mt-1 text-2xl font-bold text-white">{ strconv.FormatInt(value, 10) }</dd></div>
}

templ administrationAccountsBody(page administrationAccountsView) {
	<section aria-labelledby="accounts-title"><h1 id="accounts-title" class="text-3xl font-bold text-white">Accounts</h1>
		<ul class="mt-6 space-y-4">
			for _, account := range page.Accounts {
				<li class="rounded-lg border border-slate-800 bg-slate-900 p-4"><a class="font-semibold text-cyan-200" href={ account.URL } hx-get={ account.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{ account.DisplayName }</a><p class="mt-1 text-sm text-slate-400">{ account.Role } · { account.Status }</p></li>
			}
		</ul>
		if page.NextURL != "" {
			<a class="mt-6 inline-block text-cyan-200" href={ page.NextURL } hx-get={ page.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Next accounts</a>
		}
	</section>
}

templ administrationAccountBody(page administrationAccountView) {
	<section aria-labelledby="account-title"><h1 id="account-title" class="text-3xl font-bold text-white">{ page.DisplayName }</h1><p class="mt-2 text-slate-300">{ page.Role } · { page.Status } · identity { page.AuthentikSyncState }</p>
		if page.SessionsURL != "" {
			<a class="mt-5 inline-flex min-h-11 items-center rounded-md border border-slate-700 px-4 py-2 font-semibold text-cyan-200" href={ page.SessionsURL } hx-get={ page.SessionsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Manage local sessions</a>
		}
		if page.ReconcileAction != "" {
			<form method="post" action={ page.ReconcileAction } hx-post={ page.ReconcileAction } class="mt-6 grid gap-3 rounded-lg border border-amber-700 bg-slate-900 p-5">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<label class="grid gap-2 text-sm font-semibold text-slate-200">Audit reason <input required maxlength="2000" autocomplete="off" name="reason" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300"/></label><button class="min-h-11 w-fit rounded-md border border-amber-700 px-4 py-2 font-semibold text-amber-100 hover:border-amber-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber-300">Retry identity reconciliation</button>
			</form>
		}
		<form method="post" action={ page.RoleAction } hx-post={ page.RoleAction } class="mt-6 grid gap-3 rounded-lg border border-slate-800 bg-slate-900 p-5">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="expected_role" value={ page.Role }/><input type="hidden" name="revision" value={ page.Revision }/>
		<label>Role <select name="role" class="bg-slate-950"><option selected?={ page.Role == "member" } value="member">member</option><option selected?={ page.Role == "moderator" } value="moderator">moderator</option><option selected?={ page.Role == "administrator" } value="administrator">administrator</option></select></label>
			<label>Audit reason <input required name="reason" class="bg-slate-950"/></label><button class="w-fit rounded bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Change role</button>
		</form>
		<h2 class="mt-8 text-2xl font-bold text-white">Group membership</h2>
		<ul class="mt-4 space-y-4">
			for _, group := range page.Groups {
				<li class="rounded border border-slate-800 p-4"><span class="font-semibold">{ group.Name }</span><form method="post" action={ group.ActionURL } hx-post={ group.ActionURL } class="mt-2 flex flex-wrap gap-2"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="revision" value={ page.Revision }/><input type="hidden" name="action" value={ group.Action }/><input required name="reason" aria-label="Audit reason" class="bg-slate-950"/><button class="rounded border border-cyan-700 px-3 py-1">{ group.Label }</button></form></li>
			}
		</ul>
		if page.NextGroupsURL != "" {
			<a class="mt-6 inline-block text-cyan-200" href={ page.NextGroupsURL } hx-get={ page.NextGroupsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Next groups</a>
		}
	</section>
}

templ administrationControlBody(page administrationControlView) {
	<section aria-labelledby="control-title">
		<h1 id="control-title" class="text-3xl font-bold text-white">Control settings</h1>
		<p class="mt-3 max-w-3xl text-slate-300">Change bounded registration, maintenance, publication, and session policy. Deployment ceilings cannot be raised here.</p>
		<form method="post" action={ page.ActionURL } hx-post={ page.ActionURL } class="mt-8 grid min-w-0 gap-5 rounded-xl border border-slate-800 bg-slate-900 p-4 sm:p-6">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<input type="hidden" name="revision" value={ page.Revision }/>
			<label class="grid gap-2 font-semibold text-slate-200">Registration mode
				<select name="registration_mode" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base">
					<option value="closed" selected?={ page.Registration == "closed" }>Closed</option>
					<option value="verified_email_open" selected?={ page.Registration == "verified_email_open" }>Verified email open</option>
					<option value="administrator_approval" selected?={ page.Registration == "administrator_approval" }>Administrator approval</option>
					<option value="invitation_only" selected?={ page.Registration == "invitation_only" }>Invitation only</option>
				</select>
			</label>
			<label class="grid gap-2 font-semibold text-slate-200">Maintenance
				<select name="maintenance_enabled" class="min-h-11 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base">
					<option value="disabled" selected?={ !page.MaintenanceEnabled }>Disabled</option>
					<option value="enabled" selected?={ page.MaintenanceEnabled }>Enabled</option>
				</select>
			</label>
			<label class="grid gap-2 font-semibold text-slate-200">Maintenance message
				<input name="maintenance_message" value={ page.MaintenanceMessage } maxlength="280" class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/>
			</label>
			<div class="grid min-w-0 gap-5 sm:grid-cols-2">
				@administrationControlNumber("Established account publish limit", "publish_rate_limit", page.PublishLimit)
				@administrationControlNumber("New account publish limit", "new_account_publish_rate_limit", page.NewAccountLimit)
				@administrationControlNumber("Publish window (seconds)", "publish_window_seconds", page.PublishWindow)
				@administrationControlNumber("New account period (seconds)", "new_account_period_seconds", page.NewAccountPeriod)
				@administrationControlNumber("Session idle limit (seconds)", "session_idle_seconds", page.SessionIdle)
				@administrationControlNumber("Authentication revalidation interval (seconds)", "auth_revalidate_seconds", page.AuthRevalidate)
			</div>
			<label class="grid gap-2 font-semibold text-slate-200">Audit reason
				<input required name="reason" maxlength="2000" autocomplete="off" class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/>
			</label>
			<button class="min-h-11 w-fit rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Save control settings</button>
		</form>
	</section>
}

templ administrationControlNumber(label, name, value string) {
	<label class="grid min-w-0 gap-2 font-semibold text-slate-200">{ label }
		<input required type="number" min="1" name={ name } value={ value } class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/>
	</label>
}

templ administrationSessionsBody(page administrationSessionsView) {
	<section aria-labelledby="sessions-title">
		<h1 id="sessions-title" class="break-words text-3xl font-bold text-white">Local sessions for { page.DisplayName }</h1>
		<p class="mt-3 max-w-3xl text-slate-300">Only finite local session times are shown. Network addresses, user agents, credentials, and Authentik sessions are never exposed.</p>
		if len(page.Sessions) == 0 {
			<p class="mt-6 rounded-lg border border-slate-800 bg-slate-900 p-5 text-slate-300">No active local sessions.</p>
		} else {
			<ul class="mt-6 grid gap-4">
				for _, session := range page.Sessions {
					<li class="min-w-0 rounded-lg border border-slate-800 bg-slate-900 p-4">
						<dl class="grid gap-2 text-sm sm:grid-cols-2">
							<div><dt class="text-slate-400">Issued</dt><dd class="break-words text-white">{ session.IssuedAt }</dd></div>
							<div><dt class="text-slate-400">Last seen</dt><dd class="break-words text-white">{ session.LastSeenAt }</dd></div>
							<div><dt class="text-slate-400">Last validated</dt><dd class="break-words text-white">{ session.ValidatedAt }</dd></div>
							<div><dt class="text-slate-400">Expires</dt><dd class="break-words text-white">{ session.ExpiresAt }</dd></div>
						</dl>
						<form method="post" action={ session.RevokeURL } hx-post={ session.RevokeURL } class="mt-4 grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
							<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
							<label class="grid min-w-0 gap-2 text-sm font-semibold">Audit reason<input required name="reason" maxlength="2000" class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
							<button class="min-h-11 rounded-md border border-rose-700 px-4 py-2 font-semibold text-rose-100">Revoke session</button>
						</form>
					</li>
				}
			</ul>
			if page.More {
				<p class="mt-4 text-sm text-amber-200">More active sessions exist than this bounded page can show.</p>
			}
			<form method="post" action={ page.RevokeAllURL } hx-post={ page.RevokeAllURL } class="mt-8 grid min-w-0 gap-3 rounded-lg border border-rose-900 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<input type="hidden" name="revision" value={ page.Revision }/>
				<label class="grid min-w-0 gap-2 text-sm font-semibold">Audit reason for revoking all sessions<input required name="reason" maxlength="2000" class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
				<button class="min-h-11 rounded-md bg-rose-900 px-4 py-2 font-semibold text-rose-100">Revoke all sessions</button>
			</form>
		}
	</section>
}

templ administrationEmailBody(page administrationEmailView) {
	<section aria-labelledby="email-title">
		<h1 id="email-title" class="text-3xl font-bold text-white">Email</h1>
		if page.Configured {
			<p role="status" class="mt-4 text-emerald-200">Shared SMTP transport is configured.</p>
		} else {
			<p role="status" class="mt-4 text-amber-200">Email is disabled.</p>
		}
		if page.Status != "" {
			<dl class="mt-6 grid gap-3 rounded-lg border border-slate-800 bg-slate-900 p-4 text-sm sm:grid-cols-2">
				<div><dt class="text-slate-400">Last result</dt><dd class="text-white">{ page.Status }</dd></div>
				<div><dt class="text-slate-400">Requested</dt><dd class="break-words text-white">{ page.RequestedAt }</dd></div>
				if page.CompletedAt != "" {
					<div><dt class="text-slate-400">Completed</dt><dd class="break-words text-white">{ page.CompletedAt }</dd></div>
				}
				<div><dt class="text-slate-400">Next allowed</dt><dd class="break-words text-white">{ page.NextAllowedAt }</dd></div>
			</dl>
		}
		if page.Configured {
			<form method="post" action={ page.ActionURL } hx-post={ page.ActionURL } class="mt-8 grid min-w-0 gap-3 rounded-lg border border-slate-800 bg-slate-900 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
				<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
				<label class="grid min-w-0 gap-2 text-sm font-semibold">Audit reason<input required name="reason" maxlength="2000" class="min-h-11 min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base"/></label>
				<button class="min-h-11 rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950">Send test to my verified address</button>
			</form>
		}
	</section>
}

templ administrationGroupsBody(page administrationGroupsView) {
	<section aria-labelledby="groups-title"><h1 id="groups-title" class="text-3xl font-bold text-white">Groups</h1>
		<form method="post" action={ page.CreateAction } hx-post={ page.CreateAction } class="mt-6 flex flex-wrap gap-2 rounded border border-slate-800 p-4"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input required name="name" aria-label="Group name" class="bg-slate-950"/><input required name="reason" aria-label="Audit reason" class="bg-slate-950"/><button class="rounded bg-cyan-300 px-3 py-1 text-slate-950">Create group</button></form>
		<ul class="mt-6 space-y-4">
			for _, group := range page.Groups {
				<li class="rounded border border-slate-800 bg-slate-900 p-4"><form method="post" action={ group.ActionURL } hx-post={ group.ActionURL } class="flex flex-wrap gap-2"><input type="hidden" name="_csrf" value={ page.CSRFToken }/><input type="hidden" name="revision" value={ group.Revision }/><input required name="name" value={ group.Name } aria-label="Group name" class="bg-slate-950"/><input required name="reason" aria-label="Audit reason" class="bg-slate-950"/><button class="rounded border border-cyan-700 px-3 py-1">Rename</button></form></li>
			}
		</ul>
		if page.NextURL != "" {
			<a class="mt-6 inline-block text-cyan-200" href={ page.NextURL } hx-get={ page.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Next groups</a>
		}
	</section>
}

templ administrationAreasBody(page administrationAreasView) {
	<section aria-labelledby="areas-admin-title">
		<p class="text-sm font-semibold uppercase tracking-wider text-cyan-300">Administration</p>
		<h1 id="areas-admin-title" class="mt-2 text-3xl font-bold tracking-tight text-white">Areas</h1>
		<p class="mt-3 max-w-3xl text-slate-300">Create and manage the discussion areas where topics and replies live.</p>
		<form method="post" action={ page.CreateAction } hx-post={ page.CreateAction } class="mt-8 grid gap-6 rounded-xl border border-slate-800 bg-slate-900 p-4 shadow-lg shadow-black/20 sm:p-6">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<h2 class="text-xl font-semibold text-white">Create area</h2>
			@administrationAreaCreateFields()
			<button class="min-h-11 w-fit rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Create area</button>
		</form>
		<h2 class="mt-10 text-2xl font-bold text-white">Existing areas</h2>
		<ul class="mt-5 grid gap-4">
			for _, area := range page.Areas {
				<li class="min-w-0 rounded-lg border border-slate-800 bg-slate-900 p-4 sm:p-5">
					<a class="break-words font-semibold text-cyan-200 underline decoration-cyan-700 underline-offset-4 hover:text-cyan-100 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300" href={ area.URL } hx-get={ area.URL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">{ area.Name }</a>
					<p class="mt-2 break-words text-sm text-slate-400">/{ area.Slug } · { area.Visibility } · { area.PostingMode } · { strconv.FormatInt(area.GroupCount, 10) } groups</p>
				</li>
			}
		</ul>
		if page.NextURL != "" {
			<a class="mt-6 inline-flex min-h-11 items-center rounded-md border border-slate-700 px-4 py-2 font-semibold text-cyan-200 hover:border-cyan-700 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300" href={ page.NextURL } hx-get={ page.NextURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Next areas</a>
		}
	</section>
}

templ administrationAreaBody(page administrationAreaView) {
	<section aria-labelledby="area-admin-title">
		<p class="text-sm font-semibold uppercase tracking-wider text-cyan-300">Area administration</p>
		<h1 id="area-admin-title" class="mt-2 break-words text-3xl font-bold tracking-tight text-white">{ page.Name }</h1>
		<p class="mt-2 break-words text-slate-300">/{ page.Slug }</p>
		<form method="post" action={ page.ActionURL } hx-post={ page.ActionURL } class="mt-8 grid gap-6 rounded-xl border border-slate-800 bg-slate-900 p-4 shadow-lg shadow-black/20 sm:p-6">
			<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
			<h2 class="text-xl font-semibold text-white">Area settings</h2>
			@administrationAreaUpdateFields(page.Name, page.Description, page.DisplayOrder, page.Visibility, page.PostingMode, page.Revision)
			<button class="min-h-11 w-fit rounded-md bg-cyan-300 px-4 py-2 font-semibold text-slate-950 hover:bg-cyan-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">Update area</button>
		</form>
		<h2 class="mt-10 text-2xl font-bold text-white">Group access</h2>
		<p class="mt-2 max-w-3xl text-slate-300">Grant or revoke access for one group at a time. Every change requires an audit reason.</p>
		<ul class="mt-5 grid gap-4">
			for _, group := range page.Groups {
				<li class="min-w-0 rounded-lg border border-slate-800 bg-slate-900 p-4 sm:p-5">
					<h3 class="break-words font-semibold text-white">{ group.Name }</h3>
					<form method="post" action={ group.ActionURL } hx-post={ group.ActionURL } data-area-group-action class="mt-4 grid min-w-0 gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
						<input type="hidden" name="_csrf" value={ page.CSRFToken }/>
						<input type="hidden" name="revision" value={ page.Revision }/>
						<input type="hidden" name="action" value={ group.Action }/>
						<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Audit reason<input required name="reason" maxlength="2000" autocomplete="off" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
						<button class="min-h-11 w-fit rounded-md border border-cyan-700 px-4 py-2 font-semibold text-cyan-100 hover:border-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{ group.Label }</button>
					</form>
				</li>
			}
		</ul>
		if page.NextGroupsURL != "" {
			<a class="mt-6 inline-flex min-h-11 items-center rounded-md border border-slate-700 px-4 py-2 font-semibold text-cyan-200 hover:border-cyan-700 hover:text-cyan-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300" href={ page.NextGroupsURL } hx-get={ page.NextGroupsURL } hx-target="#main-content" hx-swap="outerHTML" hx-push-url="true">Next groups</a>
		}
	</section>
}

templ administrationAreaCreateFields() {
	<div data-area-identity-fields class="grid min-w-0 gap-5 sm:grid-cols-2">
		<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Slug<input required name="slug" maxlength="80" pattern="[a-z0-9]+(-[a-z0-9]+)*" autocomplete="off" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/><span class="text-xs font-normal text-slate-400">Lowercase letters, numbers, and single hyphens.</span></label>
		<label class="grid min-w-0 content-start gap-2 text-sm font-semibold text-slate-200">Name<input required name="name" maxlength="120" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
	</div>
	@administrationAreaCoreFields("", "0", "public", "normal", true)
}

templ administrationAreaUpdateFields(name, description, order, visibility, posting, revision string) {
	<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Name<input required name="name" value={ name } maxlength="120" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
	@administrationAreaCoreFields(description, order, visibility, posting, false)
	<input type="hidden" name="revision" value={ revision }/>
}

templ administrationAreaCoreFields(description, order, visibility, posting string, creating bool) {
	<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Description<textarea name="description" maxlength="4000" rows="4" class="w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300">{ description }</textarea></label>
	<div data-area-policy-fields class="grid min-w-0 gap-5 sm:grid-cols-3">
		<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Display order<input required type="number" min="0" max="2147483647" name="display_order" value={ order } inputmode="numeric" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
		<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Visibility<select name="visibility" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option selected?={ visibility == "public" } value="public">Public</option><option selected?={ visibility == "authenticated" } value="authenticated">Signed-in members</option><option selected?={ visibility == "groups" } value="groups">Selected groups</option></select></label>
		<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Posting mode<select name="posting_mode" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"><option selected?={ posting == "normal" } value="normal">Normal</option><option selected?={ posting == "read_only" } value="read_only">Read only</option><option selected?={ posting == "archived" } value="archived">Archived</option></select></label>
	</div>
	<div class="grid min-w-0 gap-5 sm:grid-cols-2">
		if creating {
			<label class="grid min-w-0 gap-2 text-sm font-semibold text-slate-200">Initial access group ID <span class="text-xs font-normal text-slate-400">Required only when creating an area visible to selected groups.</span><input name="initial_group_id" type="number" min="1" inputmode="numeric" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
		} else {
			<input type="hidden" name="initial_group_id" value=""/>
		}
		<label class="grid min-w-0 content-start gap-2 text-sm font-semibold text-slate-200">Audit reason<input required name="reason" maxlength="2000" autocomplete="off" class="min-h-11 w-full min-w-0 rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-base text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-300"/></label>
	</div>
}
