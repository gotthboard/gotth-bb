FROM alpine@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

ARG GOTTH_BB_VERSION
ARG GOTTH_BB_COMMIT

LABEL org.opencontainers.image.title="GOTTH Board" \
      org.opencontainers.image.version="${GOTTH_BB_VERSION}" \
      org.opencontainers.image.revision="${GOTTH_BB_COMMIT}"

COPY --chmod=0755 gotth-bb /usr/local/bin/gotth-bb
COPY --chmod=0755 gotth-bb-migrate /usr/local/bin/gotth-bb-migrate
COPY --chmod=0755 gotth-bb-operator /usr/local/bin/gotth-bb-operator
COPY --chmod=0755 deploy/container/entrypoint.sh /usr/local/bin/gotth-bb-entrypoint

USER 65532:65532
EXPOSE 18082

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:18082/health/live"]

ENTRYPOINT ["/usr/local/bin/gotth-bb-entrypoint"]
CMD ["/usr/local/bin/gotth-bb"]
