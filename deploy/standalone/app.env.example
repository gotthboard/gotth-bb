APP_ENV=production
PUBLIC_BASE_URL=https://board.example.org
BASE_PATH=
OIDC_ISSUER_URL=https://auth.board.example.org/application/o/gotth-bb/
OIDC_CLIENT_ID=gotth-bb
AUTHENTIK_CONTROL_OBJECTS_FILE=/run/config/authentik-control-objects.json
AUTHENTIK_CONTROL_SOCKET=/run/gotth-bb-control/authentik-control.sock
INVITATION_FINGERPRINT_KEY_FILE=/run/secrets/invitation_fingerprint_key
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_FROM=
SMTP_TLS_MODE=
SMTP_TIMEOUT=
BOOTSTRAP_ADMIN_SUBJECT=REPLACE_WITH_EXACT_AUTHENTIK_USER_UUID
REGISTRATION_URL=https://auth.board.example.org/if/flow/gotth-bb-enrollment/
REGISTRATION_ENABLED=false
SESSION_COOKIE_NAME=gotth_bb_session
SESSION_MAX_AGE=24h
SESSION_IDLE_TIMEOUT=8h
AUTH_REVALIDATE_INTERVAL=30m
LOG_LEVEL=info
REQUEST_RATE_LIMIT=300
REQUEST_RATE_WINDOW=60s
REQUEST_RATE_CLIENT_CAPACITY=4096
PUBLISH_RATE_LIMIT=10
NEW_ACCOUNT_PUBLISH_RATE_LIMIT=3
PUBLISH_RATE_WINDOW=10m
NEW_ACCOUNT_PERIOD=24h
