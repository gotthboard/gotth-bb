GOTTH_BB_IMAGE=gotth-bb:1.0.0-beta.1.N-COMMIT
GOTTH_BB_IMAGE_ID=sha256:REPLACE_WITH_EXACT_LOCAL_IMAGE_ID
GOTTH_BB_ENV_FILE=/etc/gotth-bb/app.env
GOTTH_BB_PUBLIC_BASE_URL=https://board.example.org
GOTTH_BB_AUTH_PUBLIC_BASE_URL=https://auth.board.example.org
GOTTH_BB_OIDC_REDIRECT_URI=https://board.example.org/auth/callback
GOTTH_BB_BOARD_HOST=board.example.org
GOTTH_BB_AUTH_HOST=auth.board.example.org
GOTTH_BB_CADDY_BIND=0.0.0.0
GOTTH_BB_CADDY_CLIENT_ADDRESS={remote_host}
GOTTH_BB_AUTH_HTTP_PORT=19000
GOTTH_BB_APP_HTTP_PORT=18082
GOTTH_BB_CADDY_ADMIN=127.0.0.1:2019
GOTTH_BB_POSTGRES_PORT=55435
GOTTH_BB_CADDY_DATA_DIR=/srv/gotth-bb/caddy-data
GOTTH_BB_CADDY_CONFIG_DIR=/srv/gotth-bb/caddy-config
GOTTH_BB_POSTGRES_DATA_DIR=/srv/gotth-bb/board-postgresql
GOTTH_BB_AUTHENTIK_POSTGRES_DATA_DIR=/srv/gotth-bb/authentik-postgresql
GOTTH_BB_AUTHENTIK_DATA_DIR=/srv/gotth-bb/authentik-data
GOTTH_BB_AUTHENTIK_TEMPLATES_DIR=/srv/gotth-bb/authentik-templates
GOTTH_BB_AUTHENTIK_CERTS_DIR=/srv/gotth-bb/authentik-certs
GOTTH_BB_ABUSE_RULES_FILE=/etc/gotth-bb/abuse-rules
GOTTH_BB_POSTGRES_MIGRATE_PASSWORD_FILE=/etc/gotth-bb/secrets/board-postgres-migrate-password
GOTTH_BB_POSTGRES_RUNTIME_PASSWORD_FILE=/etc/gotth-bb/secrets/board-postgres-runtime-password
GOTTH_BB_DATABASE_URL_FILE=/etc/gotth-bb/secrets/board-database-url
GOTTH_BB_OIDC_CLIENT_SECRET_FILE=/etc/gotth-bb/secrets/oidc-client-secret
GOTTH_BB_ACTIVITY_CURSOR_KEYRING_FILE=/etc/gotth-bb/secrets/activity-cursor-keyring
GOTTH_BB_AUTHENTIK_POSTGRES_PASSWORD_FILE=/etc/gotth-bb/secrets/authentik-postgres-password
GOTTH_BB_AUTHENTIK_SECRET_KEY_FILE=/etc/gotth-bb/secrets/authentik-secret-key
